# DevScope Local Configuration Example
# Copy this file to .env.local to customize. Never commit real tokens or .env.local to Git.

# Network binding (defaults to localhost-only for security)
HOST=127.0.0.1
PORT=3100

# Local SQLite database file path (defaults to .devscope/devscope.db)
DEVSCOPE_DB_PATH=.devscope/devscope.db

# Comma-separated workspace roots to discover projects and Git repositories
# Defaults to the user home directory and Antigravity trusted workspaces
DEVSCOPE_WORKSPACE_ROOTS=

# Antigravity installation directory override (defaults to ~/.gemini)
ANTIGRAVITY_HOME=

# Optional GitHub Personal Access Token
# DevScope automatically uses `gh` CLI or Git Credential Manager when authenticated,
# and falls back to GITHUB_TOKEN if provided here.
GITHUB_TOKEN=ghp_your_personal_access_token_placeholder

# Optional AI Provider API Keys for external billing/usage adapters
OPENAI_API_KEY=sk-proj-placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder
GEMINI_API_KEY=AIzaSy-placeholder
